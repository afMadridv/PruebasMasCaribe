# ============================================================
# CADDY: sirve el portal y hace de puente con Supabase
# ============================================================
# Va en /etc/caddy/Caddyfile. Se baja con curl, NO se pega a mano:
# la indentación dispara el autocompletado de bash en una terminal
# interactiva y el archivo queda con listados de directorio metidos
# entre las líneas.
#
#   curl -sL https://raw.githubusercontent.com/afMadridv/PruebasMasCaribe/main/portal/supabase/servidor/Caddyfile -o /etc/caddy/Caddyfile
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# LOS BLOQUES VAN EN VARIAS LÍNEAS, SIEMPRE
#   Caddyfile no admite `handle /x/* { directiva }` en un solo renglón.
#   Después de `{` no puede ir nada más en esa línea. El error que sale
#   si se intenta:
#
#     Error: adapting config using caddyfile:
#     Unexpected next token after '{' on same line
#
# CUANDO HAYA DOMINIO
#   Cambia la primera línea por el nombre real, por ejemplo
#   `portal.tudominio.com {`, y recarga. Caddy pide el certificado
#   solo. Nada más cambia aquí.
# ============================================================

144.172.108.56.sslip.io {

    # ---- Cabeceras ----
    # HSTS sin `includeSubDomains`: este nombre es de sslip.io, un
    # dominio compartido, y marcar sus subdominios afectaría a sitios
    # ajenos en el navegador de quien entre aquí.
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # ---- La API de Supabase ----
    # SOLO estas rutas. Si se manda la raíz también, Supabase Studio
    # queda abierto a internet detrás de una sola contraseña, y Studio
    # trabaja con service_role, que salta toda la seguridad RLS: quien
    # entre ve y modifica todos los expedientes.
    #
    # Studio se sigue usando por el túnel SSH, que es su sitio:
    #   ssh -L 8000:localhost:8000 root@144.172.108.56
    handle /rest/v1/* {
        reverse_proxy localhost:8000
    }
    handle /auth/v1/* {
        reverse_proxy localhost:8000
    }
    handle /storage/v1/* {
        reverse_proxy localhost:8000
    }
    handle /realtime/v1/* {
        reverse_proxy localhost:8000
    }
    handle /functions/v1/* {
        reverse_proxy localhost:8000
    }

    # ---- Lo que el repositorio trae y no es la web ----
    # Los SQL del esquema, la auditoría de seguridad y .git con todo el
    # historial. No llevan secretos, pero le regalan a cualquiera el
    # mapa de la base: qué tablas hay, qué políticas las protegen y
    # dónde están las costuras.
    @privado {
        path /portal/supabase/*
        path /.git/*
        path /*.md
    }
    handle @privado {
        respond 404
    }

    # ---- El sitio público y el portal ----
    handle {
        root * /srv/portal
        file_server
    }

    # ---- Página de error propia ----
    # Una dirección mal escrita daba el 404 gris de Caddy, que no se
    # parece en nada al portal y no ofrece salida.
    #
    # Esto NO alcanza a las rutas de @privado: ahí `respond 404` es una
    # respuesta normal, no un error, así que sigue saliendo vacío. Es lo
    # que se quiere: a quien anda probando rutas no se le regala una
    # página bonita que confirme que el sitio existe.
    handle_errors {
        root * /srv/portal
        rewrite * /404.html
        file_server {
            status {err.status_code}
        }
    }
}
